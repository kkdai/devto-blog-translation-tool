# Dev.to API Configuration
# Get your API key from: https://dev.to/settings/extensions
DEVTO_API_KEY=your_devto_api_key_here

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Chinese Image Translation Configuration
# If GCS_BUCKET is not set, image translation is disabled.
# Uses Application Default Credentials (`gcloud auth application-default login`).
# The bucket should be publicly readable (e.g., allUsers -> Storage Object Viewer).
GCS_BUCKET=
# Optional: Gemini image generation model (default: gemini-3-pro-image-preview)
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
